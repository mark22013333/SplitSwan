# 公司設定檔範本：複製成 company.env，填入實際值後交給同事，
# 在 App「設定」頁按「匯入公司設定檔…」選取即可（會存到 ~/.config/splitswan/company.env）。
# 這份檔案含公司位址，請私下傳送，不要提交版控。

# 顯示在設定頁的名稱（選填）
SPLITSWAN_PRESET_NAME="My Company"

# VPN 閘道，最多 3 台，逗號分隔；「自動輪替」會依序嘗試
SPLITSWAN_GATEWAYS="203.0.113.10,203.0.113.20,203.0.113.30"

# 要走 VPN 的網段，逗號分隔；單一主機寫 IP/32。不要用 0.0.0.0/0（見 README 已知問題）
SPLITSWAN_REMOTE_TS="10.0.0.0/24,198.51.100.5/32"
