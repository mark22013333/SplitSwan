# 放到 /opt/homebrew/etc/swanctl/conf.d/secrets.conf，並執行 chmod 600
# 把 <...> 換成實際值；不要把這個檔案貼到任何對話或版控。
secrets {
    # 預設共享金鑰。三台 gateway 若 PSK 不同，改成三段並各加 id = <gateway IP>
    ike-fortigate {
        secret = "<PRESHARED_KEY>"
    }
    # EAP 帳密（FortiClient 的「用戶名」與登入密碼）
    eap-user {
        id = <你的帳號>
        secret = "<VPN_PASSWORD>"
    }
}
