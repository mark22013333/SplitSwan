#!/bin/bash
set -euo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
ROOT=/usr/local/libexec/splitswan-route-helper
WORKER=/usr/local/libexec/splitswan-company-backend
case "${1:-}" in
  external)
    [ $# -eq 2 ] || exit 2
    case "$2" in prepare|tick|restore|status|inspect) exec "$ROOT" "$2" ;; *) exit 2 ;; esac ;;
  up)
    [ $# -le 3 ] || exit 2
    case "${2:-auto}" in auto|1|2|3) ;; *) exit 2 ;; esac
    exec "$ROOT" company-up "${2:-auto}" "${3:-}" ;;
  down|reload|reload-settings)
    [ $# -eq 1 ] || exit 2
    exec "$ROOT" "company-$1" ;;
  log)
    [ $# -eq 1 ] || exit 2
    "$ROOT" company-log-ready >/dev/null
    exec "$WORKER" log ;;
  status|sas|logtrim)
    [ $# -eq 1 ] || exit 2
    exec "$WORKER" "$1" ;;
  *) echo "usage: splitswan-helper {status|up [auto|1|2|3] [revision]|down|reload|reload-settings|log|sas|logtrim|external operation}" >&2; exit 2 ;;
esac
