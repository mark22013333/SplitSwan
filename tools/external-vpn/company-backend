#!/bin/bash
# 公司 VPN 輔助程式（以 root 執行，由 SplitSwan.app 透過 sudo -n 呼叫）
# 安裝位置：/usr/local/libexec/splitswan-helper（root:wheel 755，一般使用者不可改）
#
#   splitswan-helper status        輸出一行：connected <conn> <虛擬IP> <本機IP> <已建立秒數> | connecting <conn> | disconnected
#                                （舊版只輸出前三欄；App 要能處理兩種格式）
#   splitswan-helper up [auto|1|2|3]  成功：ok vpnN；失敗：每台一行 reason vpnN <原因代碼>，最後 fail vpnN（或 fail all）
#                                （舊版沒有 reason 行；App 要能處理兩種格式）
#                                連上後若任一遠端網段的路由沒走 utun，會重啟 charon 再連一次（只一次），
#                                並在 ok／fail 之前另起一行：route vpnN fixed|bad|failed <原本的介面>；
#                                強制結束 charon 時多一行 route vpnN killed；沒有可判斷的網段時 route vpnN skip <略過數>
#                                （舊版沒有 route 行；App 要能處理兩種格式）
#   splitswan-helper down
#   splitswan-helper log           即時輸出 charon log
#   splitswan-helper reload        重新載入設定（App 儲存設定後呼叫）
#   splitswan-helper reload-settings  重新讀取 strongswan.conf（重送參數、log 設定）
#   splitswan-helper sas           輸出 swanctl --list-sas 原始結果（唯讀，排查用）
#   splitswan-helper logtrim       charon log（/var/log/splitswan/charon.log）超過 2 MB 時就地截斷成最後 1 MB
#
# 只接受上面這幾種參數，其餘一律拒絕（sudoers 免密碼只放行這支程式）。
set -uo pipefail
[ "$(id -u)" -eq 0 ] || { echo "root worker required" >&2; exit 1; }
unset STRONGSWAN_CONF
COORDINATOR=$PPID
WORKER_PID=$$
( while kill -0 "$COORDINATOR" 2>/dev/null; do sleep 1; done; kill -TERM "$WORKER_PID" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
WATCHDOG=$!
PATH=/usr/bin:/bin:/usr/sbin:/sbin

SS=/opt/homebrew/opt/strongswan
SWANCTL="$SS/bin/swanctl"
CHARON="$SS/libexec/ipsec/charon"
# 查路由與本機介面網段用；tools/test-stale-route.sh 會把副本的這兩行換成假程式
ROUTE=/sbin/route
IFCONFIG=/sbin/ifconfig
CONNS=(vpn1 vpn2 vpn3)
# charon 的 filelog（由 App 產生的 strongswan.d/splitswan.conf 指定）。固定路徑，不接受參數
LOGDIR=/var/log/splitswan
LOGFILE="$LOGDIR/charon.log"
LOG_MAX=$((2 * 1024 * 1024))   # 超過這個大小才截斷
LOG_KEEP=$((1024 * 1024))      # 截斷後保留最後這麼多

# 暫存檔（swanctl 輸出）放這裡；tools/test-classify.sh 會把副本的這一行換成自己的暫存目錄
HELPER_TMPDIR=/tmp

# ---- 可被中斷的 swanctl 呼叫 ----
# App 逾時會對 sudo 送 SIGTERM（sudo 轉給本程式）。bash 執行前景指令或命令替換時會把 trap 延後到
# 指令結束才處理，swanctl 就會變成 root 孤兒；所以 swanctl 一律背景執行再 wait，
# wait 期間收到訊號會立刻進 trap，把記下的子程序結束掉、清掉暫存檔再離開。
# 不用 kill 0：本程式可能跟 App 在同一個 process group，會連 App 一起結束。
CHILD=""
TMPFILES=()
cleanup_tmp() {
  local f
  for f in ${TMPFILES[@]+"${TMPFILES[@]}"}; do rm -f "$f"; done
  TMPFILES=()
}
on_signal() {
  trap '' TERM INT HUP
  if [ -n "$CHILD" ]; then kill -TERM "$CHILD" 2>/dev/null; fi
  if [ -n "$CHILD" ]; then
    sleep 0.1
    kill -KILL "$CHILD" 2>/dev/null || true
    wait "$CHILD" 2>/dev/null
  fi
  cleanup_tmp
  exit 143
}
trap on_signal TERM INT HUP
trap 'cleanup_tmp; kill "$WATCHDOG" 2>/dev/null || true' EXIT

# 建一個暫存檔，路徑放在 REPLY（不能用命令替換回傳，否則記錄不到 TMPFILES）
track_tmp() {
  REPLY=$(mktemp "$HELPER_TMPDIR/splitswan-helper.XXXXXX") || return 1
  TMPFILES+=("$REPLY")
}

# run_bg <輸出檔或 /dev/null> <指令…>：背景執行指令並等它結束，回傳它的結束代碼（中斷時由 on_signal 結束它）
run_bg() {
  local outf=$1 rc
  shift
  "$@" </dev/null >"$outf" 2>&1 &
  CHILD=$!
  wait "$CHILD"; rc=$?
  CHILD=""
  return "$rc"
}

# swan <輸出檔或 /dev/null> <swanctl 參數…>
swan() {
  local outf=$1
  shift
  run_bg "$outf" "$SWANCTL" "$@"
}

charon_running() { pgrep -x charon >/dev/null; }

# 啟動 charon（不檢查是否已在跑），最多等 5 秒讓 vici 可以連線
start_charon() {
  if [ "${DUAL_MODE:-no}" = yes ]; then
    STRONGSWAN_CONF=/var/run/splitswan-external/strongswan-dual.conf nohup "$CHARON" </dev/null >/dev/null 2>&1 &
  else
    nohup "$CHARON" </dev/null >/dev/null 2>&1 &
  fi
  for _ in $(seq 1 20); do
    swan /dev/null --stats && break
    sleep 0.25
  done
}

ensure_charon() {
  charon_running || start_charon
  swan /dev/null --load-all --noprompt
}

# 程序還在（殭屍不算）
pid_alive() {
  local s; s=$(ps -o stat= -p "$1" 2>/dev/null) || return 1
  [ -n "$s" ] && [ "${s#Z}" = "$s" ]
}

# 本程式負責的 charon 一定以 root 執行；tools/test-stale-route.sh 會把副本的這一行換成測試者的 uid
CHARON_UID=0

# 是不是本程式負責的 charon：argv[0]（ps comm）逐字等於 $CHARON，而且擁有者是 $CHARON_UID。
# argv[0] 任何人都能偽造，所以一定要一併比對 uid
is_own_charon() {
  [ "$(ps -o comm= -p "$1" 2>/dev/null)" = "$CHARON" ] || return 1
  [ "$(ps -o uid= -p "$1" 2>/dev/null | tr -d ' ')" = "$CHARON_UID" ]
}

# 本程式負責的 charon 的 PID。同名但路徑或擁有者不同的程序（別的安裝、別人的程式）一律不碰
own_charon_pids() {
  local p
  for p in $(pgrep -x charon); do
    is_own_charon "$p" && echo "$p"
  done
}

# 結束本程式負責的 charon：先 TERM，最多等 5 秒，仍在才 KILL（KILL 前再比對一次，避免 PID 被重用）。
# 回傳：0 已結束（或本來就沒有）、2 動用了 KILL 才結束、1 KILL 後仍在
stop_charon() {
  local pids p alive
  pids=$(own_charon_pids)
  [ -z "$pids" ] && return 0
  for p in $pids; do kill -TERM "$p" 2>/dev/null; done
  for _ in $(seq 1 20); do
    alive=""
    for p in $pids; do pid_alive "$p" && alive="$alive $p"; done
    [ -z "$alive" ] && return 0
    sleep 0.25
  done
  for p in $alive; do
    is_own_charon "$p" && kill -KILL "$p" 2>/dev/null
  done
  for _ in $(seq 1 8); do
    alive=""
    for p in $pids; do pid_alive "$p" && alive="$alive $p"; done
    [ -z "$alive" ] && return 2
    sleep 0.25
  done
  return 1
}

terminate_all() {
  # c 一定要 local：bash 是動態作用域，呼叫端（try_conn）的 c 會被覆蓋
  local c
  for c in "${CONNS[@]}"; do
    swan /dev/null --terminate --ike "$c" --force --timeout 5
  done
}

# >>> 連線與失敗分類（tools/test-classify.sh 會擷取這一段離線測試，標記行不要改）
# 把 swanctl --initiate 的輸出（stdin）分類成一個原因代碼，只輸出代碼本身：
#   auth        帳號、密碼或 PSK 錯（閘道回 AUTHENTICATION_FAILED、EAP 失敗、PSK 驗證不符）
#   proposal    加密參數不符（NO_PROPOSAL_CHOSEN）
#   ts          網段不被接受（TS_UNACCEPTABLE）
#   unreachable 閘道沒回應或連不到（重送放棄、解析不到、送不出封包）
#   timeout     swanctl --timeout 到了仍未建立
#   unknown     以上都不是
# 比對字串取自 strongSwan 6.x 的 charon／vici 訊息格式（本機 Homebrew 版二進位檔內的字串）。
# 原始輸出含 IKE 身分（帳號）與位址，絕對不可以印出來，只印代碼。
# 用 here-string 餵 grep，不用「printf | grep -q」：pipefail 下 grep -q 提早結束會讓 printf 收到 SIGPIPE，
# 輸出大時整條管線被判成失敗（明明有命中）
classify_fail() {
  local t; t=$(cat)
  if grep -qiE 'AUTHENTICATION_FAILED|EAP authentication failed|EAP_FAILURE|EAP method .* failed|MAC mismatched|no shared key found|authentication of .* failed|constraint check failed|no trusted .* public key found' <<<"$t"; then
    echo auth
  elif grep -qiE 'NO_PROPOSAL_CHOSEN|no acceptable proposal found|no matching proposal found|received proposals unacceptable|no proposal found' <<<"$t"; then
    echo proposal
  elif grep -qiE 'TS_UNACCEPTABLE|no acceptable traffic selectors|invalid traffic selectors' <<<"$t"; then
    echo ts
  elif grep -qiE 'giving up after [0-9]+ retransmits|peer not responding|unable to resolve|error writing to socket|Network is unreachable|No route to host|Host is down' <<<"$t"; then
    echo unreachable
  elif grep -qiE 'not established after [0-9]+ ?ms' <<<"$t"; then
    echo timeout
  else
    echo unknown
  fi
}

# 建立連線。成功回 0、不印任何東西；失敗另起一行印「reason vpnN <代碼>」並回 1，
# 最後的「fail vpnN／fail all」由呼叫端照舊印。
# 原因放在獨立的一行，舊版 App 只認「fail vpnN」整行比對，多一行不影響它。
# swanctl 輸出先寫到暫存檔（600，用完即清；被中斷時由 trap 清）
initiate_conn() {
  local c=$1 f reason
  if ! track_tmp; then
    # 建不了暫存檔就不收輸出，照樣連線
    if swan /dev/null --initiate --child corp --ike "$c" --timeout 20; then return 0; fi
    echo "reason $c unknown"
    swan /dev/null --terminate --ike "$c" --force --timeout 5
    return 1
  fi
  f=$REPLY
  if swan "$f" --initiate --child corp --ike "$c" --timeout 20; then
    cleanup_tmp
    return 0
  fi
  reason=$(classify_fail <"$f")
  cleanup_tmp
  echo "reason $c ${reason:-unknown}"
  swan /dev/null --terminate --ike "$c" --force --timeout 5
  return 1
}
# <<< 連線與失敗分類

# ---- 連上後檢查路由 ----
# 曾觀察到長時間執行的 charon 把遠端網段的路由裝到實體介面（下一跳是本地路由器），
# 通道建立了但流量沒進去；重新啟動 charon 後路由恢復走 utun。成因未查證，這裡只偵測與處置。

# 這些函式的結果放在 RESULT／REPLY，不用命令替換回傳：命令替換裡的子程序收不到 trap、
# 暫存檔也記不進 TMPFILES，逾時中止時會留下孤兒與暫存檔

# 連線 c 的 CHILD_SA 遠端網段，整理成「要查路由的網路位址」清單，放在 RESULT（空白分隔），
# 略過的數量放在 SKIPPED。只取位址，不輸出 swanctl 原始內容（含帳號）。略過：
#   - IPv6、位址範圍（a..b）、/0、認不得的格式
#   - 網路位址落在本機實體介面（非 utun、非 lo）直接相連的網段內：家用 LAN 與通道網段重疊時，
#     route get 本來就會走 en0，不能據此判斷 charon 裝錯路由
remote_nets() {
  local c=$1 fs fif
  RESULT=""; SKIPPED=0
  track_tmp || return 0
  fs=$REPLY
  track_tmp || { cleanup_tmp; return 0; }
  fif=$REPLY
  swan "$fs" --list-sas --ike "$c"
  run_bg "$fif" "$IFCONFIG" -a
  # 第一個檔是 ifconfig：收集非 utun／lo 介面的 IPv4 位址與遮罩。
  # 第二個檔是 SA：CHILD_SA 的遠端網段行是「    remote 10.0.0.0/24 10.1.0.0/16」，
  # IKE 那行是「remote '<身分>' @ …」（第二欄有引號），整行不算。
  # 輸出每個網段一行：「N <位址>」要查、「S」略過
  RESULT=$(awk '
    function ip2n(s,  a) { split(s, a, "."); return ((a[1] * 256 + a[2]) * 256 + a[3]) * 256 + a[4] }
    function hex2n(h,  i, v) { h = tolower(h); sub(/^0x/, "", h); v = 0
      for (i = 1; i <= length(h); i++) v = v * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1
      return v }
    function prefix(m,  b) { b = 0; while (b < 32 && m >= 2147483648) { b++; m = (m - 2147483648) * 2 }; return b }
    function same(x, y, p,  d) { d = 2 ^ (32 - p); return int(x / d) == int(y / d) }
    FILENAME == ARGV[1] {
      if ($0 ~ /^[^ \t]/) { ifc = $1; sub(/:$/, "", ifc) }
      if ($1 == "inet" && $3 == "netmask" && ifc !~ /^(utun|lo)/) { k++; lan[k] = ip2n($2); lanp[k] = prefix(hex2n($4)) }
      next
    }
    $1 == "remote" && substr($2, 1, 1) != "\047" {
      for (i = 2; i <= NF; i++) {
        t = $i; sub(/\[.*/, "", t)
        if (t !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/) { print "S"; continue }
        split(t, a, "/")
        if (a[2] + 0 == 0 || a[2] + 0 > 32) { print "S"; continue }
        x = ip2n(a[1]); inlan = 0
        for (j = 1; j <= k; j++) if (lanp[j] > 0 && same(x, lan[j], lanp[j])) inlan = 1
        if (inlan) { print "S" } else { print "N " a[1] }
      }
    }' "$fif" "$fs")
  cleanup_tmp
  SKIPPED=$(printf '%s\n' "$RESULT" | grep -c '^S$')
  RESULT=$(printf '%s\n' "$RESULT" | awk '$1=="N"{printf "%s ", $2}')
}

# 往 ip 的路由走哪個介面；查不到就是空字串
route_iface() {
  local f
  RESULT=""
  track_tmp || return 0
  f=$REPLY
  run_bg "$f" "$ROUTE" -n get "$1"
  RESULT=$(awk '$1=="interface:"{print $2; exit}' "$f")
  cleanup_tmp
}

# 檢查連線 c 每一個可判斷的遠端網段的路由。
#   回 0：全部走 utun（查不到介面的網段當作正常）
#   回 1：至少一個不是 utun，錯的介面放在 REPLY
#   回 2：有網段但全部略過（沒有可判斷的），略過數放在 REPLY，不做任何處置
# route get 的次數等於可判斷的網段數，每次是本機查詢、約數毫秒
route_check() {
  local net nets judged=0
  remote_nets "$1"
  nets=$RESULT
  REPLY=""
  for net in $nets; do
    judged=$((judged + 1))
    route_iface "$net"
    [ -z "$RESULT" ] && continue
    case "$RESULT" in utun*) continue ;; esac
    REPLY=$RESULT
    return 1
  done
  # 讀不到任何網段（SA 查詢失敗）時不另外輸出，跟舊版一樣只印 ok
  if [ "$judged" = 0 ] && [ "$SKIPPED" -gt 0 ]; then REPLY=$SKIPPED; return 2; fi
  return 0
}

# 成功印「ok vpnN」；失敗由 initiate_conn 印 reason 行。
# 連上但有遠端網段的路由沒走 utun：全部斷線、重啟 charon、重新載入設定、再連同一台，只做一次。
#   修好：route vpnN fixed <原本介面>，接著 ok vpnN
#   仍錯：route vpnN bad <介面>，接著照舊 ok vpnN（通道本身已建立）
#   重連失敗：reason 行，接著 route vpnN failed <原本介面>（呼叫端再印 fail vpnN）
#   結束 charon 時動用了 KILL：另印 route vpnN killed
#   沒有可判斷的網段：route vpnN skip <略過數>，不做任何處置
# route 行在 ok／fail 之前另起一行，舊版 App 只認「ok vpnN／fail vpnN」整行，多一行不影響它
try_conn() {
  local c=$1 bad rc
  initiate_conn "$c" || return 1
  route_check "$c"; rc=$?
  case "$rc" in
    0) echo "ok $c"; return 0 ;;
    2) echo "route $c skip $REPLY"; echo "ok $c"; return 0 ;;
  esac
  bad=$REPLY
  terminate_all
  stop_charon; rc=$?
  [ "$rc" = 2 ] && echo "route $c killed"
  start_charon
  swan /dev/null --load-all --noprompt
  if ! initiate_conn "$c"; then
    # initiate_conn 已印 reason 行
    echo "route $c failed $bad"
    return 1
  fi
  route_check "$c"; rc=$?
  case "$rc" in
    0) echo "route $c fixed $bad" ;;
    1) echo "route $c bad $REPLY" ;;
    *) echo "route $c skip $REPLY" ;;
  esac
  echo "ok $c"
  return 0
}

cmd_status() {
  if ! charon_running; then echo "disconnected"; return; fi
  local out=""
  if track_tmp; then
    swan "$REPLY" --list-sas
    out=$(cat "$REPLY")
    cleanup_tmp
  fi
  for c in "${CONNS[@]}"; do
    local block; block=$(printf '%s\n' "$out" | awk -v c="$c:" '$1==c{p=1;print;next} /^[^ ]/{p=0} p')
    [ -z "$block" ] && continue
    if printf '%s\n' "$block" | head -1 | grep -q ESTABLISHED && printf '%s\n' "$block" | grep -q INSTALLED; then
      # local 那行：local  '<IKE 身分>' @ <本機IP>[<埠>] [<虛擬IP>]
      local vip lip est
      vip=$(printf '%s\n' "$block" | sed -n 's/^ *local .*\] \[\([^]]*\)\].*/\1/p' | head -1)
      lip=$(printf '%s\n' "$block" | sed -n 's/^ *local .* @ \([^[ ]*\)\[.*/\1/p' | head -1)
      est=$(printf '%s\n' "$block" | sed -n 's/^ *established \([0-9]*\)s ago.*/\1/p' | head -1)
      echo "connected $c ${vip:--} ${lip:--} ${est:--}"
      return
    fi
    echo "connecting $c"
    return
  done
  echo "disconnected"
}

# filelog 沒有輪替功能，由這裡控制大小（規格 §5.3）。
# 一定要「就地」截斷：charon 一直開著這個檔案，寫新檔再改名的話它會繼續寫進被取代的舊檔。
# filelog 設了 append = yes（O_APPEND），charon 每次寫入都接在當下的檔尾，截斷後不會留下空洞。
cmd_logtrim() {
  # root 執行：不跟隨 symlink，也不處理被 hard link 到別處的檔案
  if [ -L "$LOGDIR" ]; then echo "fail logtrim: $LOGDIR 是 symlink"; exit 1; fi
  if [ ! -d "$LOGDIR" ]; then
    if [ -e "$LOGDIR" ]; then echo "fail logtrim: $LOGDIR 不是目錄"; exit 1; fi
    install -d -o root -g wheel -m 755 "$LOGDIR" || { echo "fail logtrim: 無法建立 $LOGDIR"; exit 1; }
  fi
  chown root:wheel "$LOGDIR" && chmod 755 "$LOGDIR" || { echo "fail logtrim: 無法設定 $LOGDIR 權限"; exit 1; }
  if [ -L "$LOGFILE" ]; then echo "fail logtrim: $LOGFILE 是 symlink"; exit 1; fi
  if [ -e "$LOGFILE" ] && [ ! -f "$LOGFILE" ]; then echo "fail logtrim: $LOGFILE 不是一般檔案"; exit 1; fi
  if [ ! -e "$LOGFILE" ]; then
    ( umask 022; : >> "$LOGFILE" ) || { echo "fail logtrim: 無法建立 $LOGFILE"; exit 1; }
  fi
  if [ "$(stat -f %l "$LOGFILE")" != "1" ]; then echo "fail logtrim: $LOGFILE 有多個 hard link"; exit 1; fi

  local size; size=$(stat -f %z "$LOGFILE") || { echo "fail logtrim: 無法讀取大小"; exit 1; }
  if [ "$size" -gt "$LOG_MAX" ]; then
    # 暫存檔放在 root 擁有的 log 目錄裡，一般使用者碰不到
    TRIM_TMP=$(mktemp "$LOGDIR/.trim.XXXXXX") || { echo "fail logtrim: 無法建立暫存檔"; exit 1; }
    # 任何方式結束（含被中斷）都清掉暫存檔
    trap 'rm -f "$TRIM_TMP"' EXIT
    trap 'rm -f "$TRIM_TMP"; exit 1' INT TERM HUP
    # 取最後 LOG_KEEP bytes，丟掉開頭被切斷的半行
    if tail -c "$LOG_KEEP" "$LOGFILE" | LC_ALL=C tail -n +2 >"$TRIM_TMP"; then
      # 以截斷方式（O_TRUNC）寫回同一個 inode，不換新檔
      cat "$TRIM_TMP" >"$LOGFILE" || { echo "fail logtrim: 寫回失敗"; exit 1; }
    fi
    rm -f "$TRIM_TMP"
    # 恢復共用的 trap（見檔頭「可被中斷的 swanctl 呼叫」）
    trap on_signal TERM INT HUP
    trap 'cleanup_tmp; kill "$WATCHDOG" 2>/dev/null || true' EXIT
  fi
  chown root:wheel "$LOGFILE" && chmod 644 "$LOGFILE" || { echo "fail logtrim: 無法設定 $LOGFILE 權限"; exit 1; }
  echo "ok logtrim $(stat -f %z "$LOGFILE")"
}

exclusive_idle() {
  local p found=0
  for p in $(pgrep -x charon); do
    is_own_charon "$p" || return 1
    found=$((found + 1))
  done
  [ "$found" -le 1 ] || return 1
  if [ "$found" = 1 ]; then
    track_tmp || return 1
    swan "$REPLY" --list-sas || return 1
    [ ! -s "$REPLY" ] || return 1
    cleanup_tmp
  fi
}

case "${1:-}" in
  dual-mode)
    exclusive_idle || exit 1
    stop_charon; rc=$?
    [ "$rc" = 1 ] && exit 1
    DUAL_MODE=yes
    start_charon
    swan /dev/null --stats || exit 1
    swan /dev/null --load-conns --file /var/run/splitswan-external/swanctl-dual.conf || exit 1
    swan /dev/null --load-creds --noprompt || exit 1
    echo "ok mode" ;;
  dual-up)
    case "${2:-}" in 1|2|3) ;; *) exit 2 ;; esac
    initiate_conn "vpn$2" ;;
  dual-down)
    case "${2:-}" in 1|2|3) ;; *) exit 2 ;; esac
    swan /dev/null --terminate --ike "vpn$2" --force --timeout 5 ;;
  normal-mode)
    exclusive_idle || exit 1
    stop_charon; rc=$?
    [ "$rc" = 1 ] && exit 1
    start_charon
    swan /dev/null --stats || exit 1
    swan /dev/null --load-creds --noprompt || exit 1
    echo "ok mode" ;;
  log-ready)
    ensure_charon ;;
  status)
    cmd_status ;;
  up)
    target="${2:-auto}"
    case "$target" in auto|1|2|3) ;; *) echo "invalid target" >&2; exit 2 ;; esac
    ensure_charon
    terminate_all
    case "$target" in
      auto) for c in "${CONNS[@]}"; do try_conn "$c" && exit 0; done
            echo "fail all"; exit 1 ;;
      1|2|3) try_conn "vpn$target" && exit 0
             echo "fail vpn$target"; exit 1 ;;
      *) echo "invalid target" >&2; exit 2 ;;
    esac ;;
  down)
    charon_running && terminate_all
    echo "ok down" ;;
  log)
    # App 內的連線紀錄會長時間串流。App 結束、當機或被強制結束時都要跟著停，
    # 所以不用 exec，改成每 2 秒確認呼叫者（sudo 的上層，也就是 App）還在
    OWNER=$(ps -o ppid= -p "$PPID" 2>/dev/null | tr -d ' ')
    "$SWANCTL" --log &
    LOGPID=$!
    trap 'kill "$LOGPID" 2>/dev/null; exit 0' TERM INT HUP
    while kill -0 "$LOGPID" 2>/dev/null; do
      if [ -n "$OWNER" ] && ! kill -0 "$OWNER" 2>/dev/null; then kill "$LOGPID" 2>/dev/null; break; fi
      sleep 2
    done
    wait "$LOGPID" 2>/dev/null
    exit 0 ;;
  reload)
    # App 儲存設定後呼叫：charon 在跑就重新載入 swanctl.conf 與 secrets.conf
    if charon_running; then swan /dev/null --load-all --noprompt; fi
    echo "ok reload" ;;
  reload-settings)
    # App 更新重送參數或 log 設定後呼叫；已建立的通道不受影響，之後的交換才套用
    if charon_running; then swan /dev/null --reload-settings || { echo "fail reload-settings"; exit 1; }; fi
    echo "ok reload-settings" ;;
  sas)
    # 唯讀：輸出 swanctl 原始 SA 清單（含雙方 traffic selector），排查用
    charon_running || { echo "charon 未執行"; exit 0; }
    exec "$SWANCTL" --list-sas ;;
  logtrim)
    # 只處理固定路徑，不接受任何參數
    [ $# -eq 1 ] || { echo "logtrim 不接受參數" >&2; exit 2; }
    cmd_logtrim ;;
  *)
    echo "usage: splitswan-helper {status|up [auto|1|2|3]|down|reload|reload-settings|log|sas|logtrim}" >&2; exit 2 ;;
esac
