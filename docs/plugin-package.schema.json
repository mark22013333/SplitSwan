{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SplitSwan Plugin Package v1",
  "description": "結構驗證；路徑碰撞、敏感檔案、版本排序、大小與檔案雜湊另由 App 與工具檢查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "name",
    "author",
    "description",
    "version",
    "minimumAppVersion",
    "entrypoint",
    "interval",
    "runtime",
    "dependencies",
    "settings",
    "files"
  ],
  "properties": {
    "formatVersion": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "minimumAppVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "entrypoint": {
      "$ref": "#/$defs/path"
    },
    "interval": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400
    },
    "runtime": {
      "enum": [
        "sh",
        "bash",
        "zsh",
        "python3",
        "node"
      ]
    },
    "dependencies": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "sh",
          "bash",
          "zsh",
          "python3",
          "node"
        ]
      }
    },
    "settings": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 999,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "executable"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "executable": {
            "type": "boolean"
          }
        }
      }
    },
    "legacyReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "sha256s"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^/\\\\:\\x00-\\x1f\\x7f]+$"
        },
        "sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\x00-\\x1f\\x7f]+$"
    }
  }
}
